{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "admin:grant": "node ./dist/grant-admin.mjs",
    "test:auth": "esbuild src/lib/authSecurity.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/platepay-auth-tests.cjs --log-level=warning && node --test /tmp/platepay-auth-tests.cjs",
    "test:wallet": "esbuild src/lib/walletTopUps.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/platepay-wallet-tests.cjs --log-level=warning && node --test /tmp/platepay-wallet-tests.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "mongoose": "^9.11.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "socks": "^2.8.10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
