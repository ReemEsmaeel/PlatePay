# Configure these through Replit Secrets in development and secure environment
# settings on the eventual hosting provider. Never commit real values.
MONGODB_URI=
# Optional SOCKS5 proxy with a static Atlas-allowlisted egress IP.
# Add proxy credentials to Replit Secrets, never this file.
MONGODB_SOCKS5_HOST=
MONGODB_SOCKS5_PORT=
MONGODB_SOCKS5_USERNAME=
MONGODB_SOCKS5_PASSWORD=
# Required: at least 32 random characters, configured through Secrets.
SESSION_SECRET=
# Optional canonical browser origin, e.g. https://your-app.vercel.app.
# When configured, mutations must originate from this exact origin.
APP_ORIGIN=
# Initial administrator: register and complete a profile, then run admin:grant
# in an operator terminal. For password recovery, admin:reset-password targets
# only this configured account and prompts without echoing the new password.
PLATEPAY_ADMIN_EMAIL=
# Keep Stripe in test mode. Configure the Stripe integration securely,
# rather than pasting payment credentials into source files.
# Vercel only: use your Stripe account's TEST secret key, never a live key.
STRIPE_SECRET_KEY=
# Signing secret of the TEST webhook pointing to /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
